# ==============================================================================
# USMAN'S PURE PRODUCTS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. PostgreSQL Database Connection String
# Provide your Supabase, Neon, or cloud PostgreSQL connection URI:
# e.g. postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# or   postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require
DATABASE_URL=
POSTGRES_URL=

# 2. Cryptographic Security Key
# Generate a strong 32+ character random secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=

# 3. Administrator Bootstrap Credentials
# Initial administrator credentials bootstrapped securely into database on first startup.
ADMIN_EMAIL=admin@usmanspure.com
ADMIN_USERNAME=admin@usmanspure.com
ADMIN_PASSWORD=

# 4. Store Email Dispatch (Namecheap Business SMTP)
SMTP_HOST=mail.usmanspure.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@usmanspure.com
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=orders@usmanspure.com

# 5. Triple Sync Channel: Google Sheets Webhook (Optional)
GOOGLE_SHEETS_WEBHOOK_URL=

# 6. WhatsApp Customer Order Routing
NEXT_PUBLIC_WHATSAPP_NUMBER=923129996658
